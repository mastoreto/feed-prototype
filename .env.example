# Local Docker DB (bun run db:up). Replace with your hosted Postgres URL in production.
STORAGE_DATABASE_URL="postgresql://postgres:feed@localhost:54329/feedprototype"
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
# Public URL of the site. In production it MUST be the real origin (https://your-domain), or sign-up fails with "Invalid origin".
BETTER_AUTH_URL="http://localhost:3000"
# Optional: Google sign-in (also set NEXT_PUBLIC_GOOGLE_ENABLED=1)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED=""
# AdSense: leave empty in dev (placeholders are shown instead of ads)
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
NEXT_PUBLIC_ADSENSE_SLOT_DASH=""
NEXT_PUBLIC_ADSENSE_SLOT_EDITOR=""
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=""
# Ad-block wall is on in production; set to "on" to force it in dev
NEXT_PUBLIC_ADBLOCK_GATE=""
